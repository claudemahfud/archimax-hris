rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // karyawan & penilaianKpi: dipakai langsung oleh app (tanpa Firebase Auth),
    // jadi read/write dibuka supaya form Tambah/Edit Karyawan & Form Penilaian KPI berfungsi.
    match /karyawan/{docId} {
      allow read, write: if true;
    }
    match /penilaianKpi/{docId} {
      allow read, write: if true;
    }

    // settings: app butuh READ untuk verifikasi Kode Akses (HRD/HOD) & login Superadmin.
    // WRITE hanya dibuka untuk dokumen aksesHrd & aksesHod — itu yang diubah lewat menu
    // "Ganti Kode Akses" di Welcome Page (setelah login Superadmin/Google di sisi client).
    // Dokumen "superadmin" (username/password) tetap read-only dari client — kalau mau
    // diganti dari default (Superadmin / Admin123), isi manual lewat tab "Data" di Firebase
    // Console.
    match /settings/{docId} {
      allow read: if true;
      // companyInfo: konten umum (Visi Misi, Tata Tertib, Kebijakan Reward) yang diedit HRD
      // lewat halaman "Profil Perusahaan" dan dibaca publik di semua halaman Rapor Online.
      // whitelistSuperadmin: daftar email yang boleh login Google sebagai Superadmin, diatur
      // Superadmin sendiri lewat halaman "Ganti Kode Akses".
      allow write: if docId == 'aksesHrd' || docId == 'aksesHod' || docId == 'companyInfo' || docId == 'whitelistSuperadmin';
    }

    // akunPortal: pendaftaran Username + Email HRD/HOD (login via Username/Password ATAU Google)
    // oleh Superadmin lewat Welcome Page. Password akun TIDAK disimpan di sini — hanya di
    // Firebase Authentication (lihat daftarkanAkunPortal di src/shared/lib/firestore.ts). Sama
    // seperti karyawan/penilaianKpi, proteksi baca/tulis dokumen ini berjalan di sisi client
    // (belum ada Firebase Auth custom claims) — dicatat sebagai catatan keamanan yang sama
    // dengan bagian lain.
    match /akunPortal/{docId} {
      allow read, write: if true;
    }
  }
}
