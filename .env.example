# Salin file ini ke .env kalau ingin override config default di src/shared/lib/firebase.ts
# (mis. pindah ke project Firebase lain / staging). Project default sudah di-hardcode sebagai
# fallback: archimax-hris.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Cloudinary — untuk upload foto profil karyawan (unsigned upload preset,
# dibuat manual di dashboard Cloudinary > Settings > Upload > Upload presets).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
